# ---------------------------------------------------------------------------
# vlm-locus
#
# The repository carries code, dataset generators, and the *small* frozen run
# artefacts that regenerate every table and figure. It deliberately does not
# carry the heavy artefacts those were computed from: captured residual-stream
# tensors, LoRA adapter weights, and the image datasets. All three are
# reproducible from the code (see README.md), and each exceeds GitHub's
# per-file limit many times over.
# ---------------------------------------------------------------------------

# Environment
.venv/
__pycache__/
*.py[cod]

# Datasets: synthetic families are regenerated by gen/; COCO val2017 and
# ChartQA are public downloads. 6.2 GB.
data/

# Captured hidden states (~200-280 MB each) and their metadata sidecars.
*.npz

# LoRA adapters (~115-182 MB each). Training hyperparameters are recorded in
# the corresponding runs/lora_*.json, so nothing about a run is lost.
*.safetensors
runs/*_adapter/

# Superseded pre-fix run kept locally for reference only.
runs/v1_contaneminated/
runs/v1_contaminated/

# Install and download logs
*.log

# Editor / OS
.DS_Store
*.swp
*~
:Zone.Identifier

# Derived output: tables, figures and canon.json are regenerated in seconds.
out/
